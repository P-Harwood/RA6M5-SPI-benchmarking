#include <zephyr/dt-bindings/pinctrl/renesas/pinctrl-ra.h>
#include <zephyr/dt-bindings/memory-attr/memory-attr-arm.h>

&pinctrl {
	adc0_default: adc0_default {
		group1 {
			/* Define the ADC input pins P00 to P06 */
			psels = <RA_PSEL(RA_PSEL_ADC, 0, 0)>,
				<RA_PSEL(RA_PSEL_ADC, 0, 1)>,
				<RA_PSEL(RA_PSEL_ADC, 0, 2)>,
				<RA_PSEL(RA_PSEL_ADC, 0, 3)>,
				<RA_PSEL(RA_PSEL_ADC, 0, 4)>,
				<RA_PSEL(RA_PSEL_ADC, 0, 5)>,
				<RA_PSEL(RA_PSEL_ADC, 0, 6)>;
			renesas,analog-enable;
		};
	};
};

&uart7 {
	current-speed = <7500000>;
	status = "disabled";
};

&adc0 {
	status = "disabled";
};



&spi0 {
	rx-dtc;
	tx-dtc;
};

/* The QSPI flash node from the board dts stays enabled: the Zephyr driver owns it.
 * Add `qpi-enable;` here for 4-4-4 page programs instead of 1-1-1. */

/* main.c enables the S cache and the QSPI register block (0x6400_0000) is Normal memory in the
 * Cortex-M33 default map, so reads of SFMCOM would come back from the cache. Make it Device
 * memory in the MPU (Renesas R11AN0538), and keep the log ring out of the cache for read backs. */
/ {
	qspi_regs: memory@64000000 {
		compatible = "zephyr,memory-region";
		reg = <0x64000000 0x1000>;
		zephyr,memory-region = "QSPI_REGS";
		zephyr,memory-attr = <( DT_MEM_ARM(ATTR_MPU_IO) )>;
	};

	qspi_log: memory@60000000 {
		compatible = "zephyr,memory-region";
		reg = <0x60000000 DT_SIZE_M(4)>;
		zephyr,memory-region = "QSPI_LOG";
		zephyr,memory-attr = <( DT_MEM_ARM(ATTR_MPU_RAM_NOCACHE) )>;
	};
};


